with "../sparkling_mujoco.gpr";

project Tools is
   for Source_Dirs use (".");
   for Object_Dir use "../obj/tools_ada";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";
   for Main use ("mjinfo.adb");
   for Languages use ("Ada");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwa");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Tools;
