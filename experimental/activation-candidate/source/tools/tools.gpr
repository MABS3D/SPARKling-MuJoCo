with "../sparkling_mujoco.gpr";

project Tools is
   for Source_Dirs use (".");
   for Object_Dir use Sparkling_Mujoco.Build_Root & "/obj/tools_ada";
   for Exec_Dir use Sparkling_Mujoco.Build_Root & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("mjinfo.adb");
   for Languages use ("Ada");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnatwa");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use Sparkling_Mujoco.Link_Switches;
   end Linker;
end Tools;
