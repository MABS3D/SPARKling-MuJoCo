project Limits is
   Build_Root := external ("LIMIT_BUILD_ROOT", "/var/tmp/sparkling-joint-limits-20261001/build");
   type Mode_Type is ("development", "validation", "release");
   Mode : Mode_Type := external ("LIMIT_MODE", "validation");
   for Source_Dirs use ("src", "../../src", "../frictionless-contact-candidate/src", "tests");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-blas.ads", "mj-blas.adb",
     "mj-vector_models.ads", "mj-vector_models.adb", "mj-quaternion_math.ads", "mj-contact_rows.ads", "mj-contact_rows.adb",
     "mj-joint_limits.ads", "mj-joint_limits.adb", "mj-joint_limit_response.ads",
     "mj-joint_limit_response.adb", "mj-joint_limit_math.ads",
     "mj-solimp_curve.ads", "mj-solimp_curve.adb", "limit_probe.adb", "solimp_probe.adb");
   for Main use ("limit_probe.adb", "solimp_probe.adb");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "development" => Flags := Flags & ("-O0", "-g", "-gnata", "-gnato", "-gnatVa");
      when "validation" => Flags := Flags & ("-O2", "-g", "-gnata", "-gnato", "-gnatVa");
      when "release" => Flags := Flags & ("-O3", "-gnatn", "-march=native", "-flto");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-flto", "-ffp-contract=off", "-lm");
   end Linker;
end Limits;
