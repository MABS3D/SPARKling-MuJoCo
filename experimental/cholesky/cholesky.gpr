with "../../sparkling_mujoco.gpr";
library project Cholesky is
   for Library_Name use "sparkling_cholesky_draft";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use Sparkling_Mujoco.Build_Root & "/obj/cholesky_draft";
   for Library_Dir use Sparkling_Mujoco.Build_Root & "/lib/cholesky_draft";
   for Create_Missing_Dirs use "True";
   --  Complete-unit numeric composition is pending. Default clients retain checks.
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-gnata", "-gnato", "-gnatVa", "-ffp-contract=off");
   end Compiler;
end Cholesky;
