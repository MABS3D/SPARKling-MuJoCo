project Proof is
   for Source_Dirs use ("src", "tests", "../../src");
   for Object_Dir use external ("PLUGIN_PROOF_ROOT", "/var/tmp/sparkling-plugin-proof") & "/obj";
   for Create_Missing_Dirs use "True";
   package Compiler is for Default_Switches ("Ada") use ("-gnat2022", "-ffp-contract=off"); end Compiler;
end Proof;
