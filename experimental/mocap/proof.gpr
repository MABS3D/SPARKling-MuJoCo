project Mocap_Proof is
   for Source_Dirs use ("../smooth/src", "../../src");
   for Object_Dir use external ("MOCAP_PROOF_ROOT", "/var/tmp/sparkling-mocap-proof") & "/obj";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-ffp-contract=off");
   end Compiler;
end Mocap_Proof;
