+with Ada.Command_Line;
+with Ada.Text_IO;
+with Ada.Exceptions;
+with MJ.Types; use MJ.Types;
+with MJ.Fields;
+with MJ.Models;
+with MJ.MJB;
+with MJ.Data; use MJ.Data;
+with MJ.Data.Constrained;
+with MJ.Data.Constrained.Diagnostic_Checks;
+procedure Movement_Diagnostics is
+   M : MJ.Models.Model;
+   type Engine_Access is access MJ.Data.Constrained.Engine;
+   E : Engine_Access := new MJ.Data.Constrained.Engine;
+   Loaded : MJ.Fields.Load_Result;
+   Result : Status;
+begin
+   MJ.MJB.Load (Ada.Command_Line.Argument (1), (Contact_Cap => 0), M, Loaded);
+   if Loaded.Status /= OK then raise Program_Error with "load"; end if;
+   MJ.Data.Constrained.Create (M, E.all, Result);
+   if Result /= Success then raise Program_Error with "create " & Result'Image; end if;
+   MJ.Models.Free (M);
+   MJ.Data.Constrained.Diagnostic_Checks.Run (E.all);
+   MJ.Data.Constrained.Free (E.all,Result);
+   if Result /= Success then raise Program_Error with "free"; end if;
+   MJ.Data.Constrained.Free (E.all,Result);
+   if Result /= Success then raise Program_Error with "double free"; end if;
+   Ada.Text_IO.Put_Line ("movement diagnostic lifecycle/frame PASS");
+exception
+   when Error : others =>
+      Ada.Text_IO.Put_Line (Ada.Exceptions.Exception_Information (Error));
+      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
+end Movement_Diagnostics;
