+with Ada.Unchecked_Conversion;
+with Interfaces;
+with MJ.Data.Forward;
+with MJ.Data.Movement;
+package body MJ.Data.Constrained.Diagnostic_Checks is
+   function Bits is new Ada.Unchecked_Conversion (Real, Interfaces.Unsigned_64);
+   use type Interfaces.Unsigned_64;
+   procedure Check (Value : Boolean; Message : String) is
+   begin
+      if not Value then raise Program_Error with Message; end if;
+   end Check;
+   function Same (A, B : Real_Array) return Boolean is
+   begin
+      if A'First /= B'First or else A'Last /= B'Last then return False; end if;
+      for I in A'Range loop
+         if Bits (A (I)) /= Bits (B (I)) then return False; end if;
+      end loop;
+      return True;
+   end Same;
+   procedure Run (E : in out Engine) is
+      Q : State_Vector (0 .. E.D.Nq-1);
+      V : State_Vector (0 .. E.D.Nv-1);
+      G, B, P, A : Real_Array (0 .. E.D.Nv-1);
+      G0, B0, P0, A0 : Real_Array (0 .. E.D.Nv-1);
+      Result : Status;
+      procedure Read_Diagnostics is
+      begin
+         Get_Forces (E.D, G, B, P, A, Result);
+         Check (Result = Success, "diagnostic availability");
+         for I in G'Range loop
+            Check (Bits (G (I)) = Bits (Force_Value (E.D, Gravity_Force, I)), "gravity scalar/bulk");
+            Check (Bits (B (I)) = Bits (Force_Value (E.D, Velocity_Bias, I)), "bias scalar/bulk");
+         end loop;
+      end Read_Diagnostics;
+   begin
+      for I in Q'Range loop Q (I) := E.D.State.Qpos (I); end loop;
+      for I in V'Range loop V (I) := 0.125 * Real ((I mod 5)-2); end loop;
+      Set_State (E, Q, V, Nonneg_Tier0'Last, Result);
+      Check (Result = Success, "state at clock bound");
+      Evaluate (E, Result); Check (Result = Success, "public evaluate");
+      Read_Diagnostics; G0 := G; B0 := B; P0 := P; A0 := A;
+      declare
+         Before : constant Real_Array := Complete_State (E);
+      begin
+         Step (E, Result);
+         Check (Result = Numeric_Limit and then Same (Complete_State (E), Before), "step clock failure atomicity");
+         Read_Diagnostics;
+         Check (Same (G,G0) and then Same (B,B0) and then Same (P,P0) and then Same (A,A0), "step failure diagnostics");
+      end;
+      -- Directly exercise cleanup with a caller-added passive contribution.
+      -- This is the frame needed by FE; it must not recompute passive forces.
+      MJ.Data.Movement.Evaluate_Physical (E.D, Result);
+      Check (Result = Success, "physical evaluation");
+      if P'Length > 0 then E.D.Dynamics.Passive (P'First) := E.D.Dynamics.Passive (P'First) + 0.375; end if;
+      P0 := E.D.Dynamics.Passive.all;
+      declare
+         Full : constant Real_Array := E.D.Dynamics.Full_Bias.all;
+         Total : constant Real_Array := E.D.Dynamics.Total.all;
+         Acc : constant Real_Array := E.D.Dynamics.Acceleration.all;
+      begin
+         Result := Capacity_Exceeded;
+         MJ.Data.Movement.Complete_On_Failure (E.D, Result);
+         Check (Result = Capacity_Exceeded, "cleanup preserves original status");
+         Read_Diagnostics;
+         Check (Same (G,G0) and then Same (B,B0) and then Same (P,P0), "cleanup diagnostic/passive frame");
+         Check (Same (E.D.Dynamics.Full_Bias.all,Full) and then Same (E.D.Dynamics.Total.all,Total)
+           and then Same (E.D.Dynamics.Acceleration.all,Acc), "cleanup physical frame");
+      end;
+      Set_State (E,Q,V,0.0,Result); Check (Result = Success, "retry state");
+      Step (E,Result); Check (Result = Success and then not Passive_Current (E.D), "successful step invalidates diagnostics");
+      Evaluate (E,Result); Check (Result = Success, "evaluate after step"); Read_Diagnostics;
+      MJ.Data.Reset (E.D,Result); Check (Result = Success and then not Passive_Current (E.D), "reset diagnostics");
+      Evaluate (E,Result); Check (Result = Success, "reset evaluation"); Read_Diagnostics;
+   end Run;
+end MJ.Data.Constrained.Diagnostic_Checks;
