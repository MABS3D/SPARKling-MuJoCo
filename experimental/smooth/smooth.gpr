with "../../sparkling_mujoco.gpr";

library project Smooth is
   for Library_Name use "sparkling_smooth_draft";
   for Library_Kind use "static";
   for Source_Dirs use ("src");
   for Object_Dir use Sparkling_Mujoco.Build_Root & "/obj/smooth_draft";
   for Library_Dir use Sparkling_Mujoco.Build_Root & "/lib/smooth_draft";
   for Create_Missing_Dirs use "True";

   --  Draft code has no established proof. Keep runtime checks enabled.
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O0", "-g", "-gnata", "-gnato", "-gnatVa", "-ffp-contract=off");
   end Compiler;
end Smooth;
