project Manifold_Math is
   for Source_Dirs use ("../../../src", "../src", ".");
   for Main use ("manifold_math_probe.adb");
   for Object_Dir use external ("MANIFOLD_BUILD_ROOT") & "/obj";
   for Exec_Dir use external ("MANIFOLD_BUILD_ROOT") & "/bin";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O0", "-g", "-gnata", "-gnato", "-gnatVa", "-ffp-contract=off");
   end Compiler;
end Manifold_Math;
