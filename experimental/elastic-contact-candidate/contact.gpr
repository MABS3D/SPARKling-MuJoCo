project Contact is
   Build_Root := external ("ELASTIC_CONTACT_BUILD", "/var/tmp/sparkling-elastic-contact-20260930");
   type Mode_Type is ("validation", "release");
   Mode : Mode_Type := external ("ELASTIC_CONTACT_MODE", "validation");
   for Source_Dirs use ("src", "tests", "../../src", "../smooth/src", "../frictionless-contact-candidate/src");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-elastic_kernels.ads", "mj-elastic_kernels.adb",
     "mj-elastic_network.ads", "mj-elastic_network.adb", "mj-contact_rows.ads", "mj-contact_rows.adb",
     "mj-elastic_contact_math.ads", "mj-elastic_contact_math.adb",
     "mj-elastic_coordinates.ads", "mj-elastic_coordinates.adb",
     "mj-elastic_contacts.ads", "mj-elastic_contacts.adb", "elastic_contact_probe.adb");
   for Main use ("elastic_contact_probe.adb");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "validation" => Flags := Flags & ("-O2", "-g", "-gnata", "-gnato", "-gnatVa");
      when "release" => Flags := Flags & ("-O3", "-gnatp", "-gnatn", "-march=native", "-flto");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-flto", "-ffp-contract=off");
   end Linker;
end Contact;
