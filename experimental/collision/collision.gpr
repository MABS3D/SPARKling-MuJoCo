project Collision is
   Build_Root := external ("COLLISION_BUILD_ROOT", "/tmp/sparkling-collision");
   for Source_Dirs use ("src", "../../src");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-collision.ads", "mj-collision.adb");
   for Object_Dir use Build_Root & "/obj";
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O0", "-g", "-gnata", "-gnato", "-gnatVa", "-gnatwa");
   end Compiler;
end Collision;
