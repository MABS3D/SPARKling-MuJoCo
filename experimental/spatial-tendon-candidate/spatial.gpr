project Spatial is
   Build_Root := external ("SPATIAL_BUILD_ROOT", "/var/tmp/sparkling-spatial-tendons-20260930/build");
   type Mode_Type is ("development", "validation", "release");
   Mode : Mode_Type := external ("SPATIAL_MODE", "validation");
   for Source_Dirs use ("src", "../../src", "tests");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-quaternion_math.ads",
     "mj-tendon_vectors.ads", "mj-tendon_vectors.adb", "mj-tendon_geometry.ads",
     "mj-tendon_geometry.adb", "mj-spatial_tendons.ads", "mj-spatial_tendons.adb",
     "spatial_probe.adb");
   for Main use ("spatial_probe.adb");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "development" => Flags := Flags & ("-O0", "-g", "-gnata", "-gnato", "-gnatVa");
      when "validation" => Flags := Flags & ("-O2", "-g", "-gnata", "-gnato", "-gnatVa");
      when "release" => Flags := Flags & ("-O3", "-gnatp", "-gnatn", "-march=native", "-flto");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-flto", "-ffp-contract=off");
   end Linker;
end Spatial;
