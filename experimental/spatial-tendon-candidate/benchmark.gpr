project Benchmark extends "spatial.gpr" is
   for Source_Dirs use ("src", "../../src", "tests");
   for Source_Files use Spatial'Source_Files & ("wrap_benchmark.adb");
   for Main use ("wrap_benchmark.adb");
   for Object_Dir use Spatial.Build_Root & "/benchmark/obj";
   for Exec_Dir use Spatial.Build_Root & "/benchmark/bin";
end Benchmark;
