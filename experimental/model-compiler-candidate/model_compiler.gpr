project Model_Compiler is
   Build_Root := external ("MODEL_COMPILER_BUILD_ROOT", "/var/tmp/sparkling-model-compiler/build");
   Mode := external ("MODEL_COMPILER_MODE", "validation");
   for Source_Dirs use ("src", "../../src", "tests");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-model_compiler.ads",
     "mj-model_compiler-addresses.ads", "mj-model_compiler-addresses.adb",
     "compiler_probe.adb");
   for Main use ("compiler_probe.adb");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "release" => Flags := Flags & ("-O3", "-gnatn", "-march=native");
      when others => Flags := Flags & ("-O1", "-g", "-gnata", "-gnato", "-gnatVa");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
end Model_Compiler;
