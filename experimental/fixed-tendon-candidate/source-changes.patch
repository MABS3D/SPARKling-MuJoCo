+      end loop;
+      Tail_Bound (Value, R'Length mod 4);
+      return Value;
+   end Sparse_Dot;
+
+   procedure Fixed_Kinematics
+     (Terms, Jacobian : Row; Q, V : Real_Array; Length, Velocity : out Coordinate)
+   is
+   begin
+      Length := Dot (Terms, Q);
+      Velocity := Sparse_Dot (Jacobian, V);
+   end Fixed_Kinematics;
