+project Controller_Arrays_Proof is
+   Build_Root := external ("ADVANCED_BUILD_ROOT");
+   Mode := external ("ADVANCED_MODE", "validation");
+   for Source_Dirs use ("src", "../../src");
+   for Source_Files use ("mj.ads", "mj-types.ads",
+     "mj-controller_array_kernels.ads", "mj-controller_array_kernels.adb");
+   for Object_Dir use Build_Root & "/" & Mode & "/obj";
+   for Create_Missing_Dirs use "True";
+   package Compiler is
+      for Default_Switches ("Ada") use ("-gnat2022", "-ffp-contract=off", "-O1", "-g", "-gnata", "-gnato", "-gnatVa");
+   end Compiler;
+end Controller_Arrays_Proof;
