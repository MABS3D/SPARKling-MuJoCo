project Stage_Probe is
   Mode := external ("STAGE_MODE", "validation");
   for Source_Dirs use (".",
     "/var/tmp/sparkling-services-controller-stage-caller2-r19-20261003/source/experimental/advanced-step/src",
     "/var/tmp/sparkling-services-controller-stage-caller2-r19-20261003/source/src");
   for Source_Files use ("stage_probe.adb", "mj.ads", "mj-types.ads", "mj-advanced_state.ads", "mj-advanced_state.adb");
   for Main use ("stage_probe.adb");
   for Object_Dir use "build/" & Mode & "/obj";
   for Exec_Dir use "build/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "release" => Flags := Flags & ("-O3", "-gnatn", "-march=native");
      when others => Flags := Flags & ("-O1", "-g", "-gnata", "-gnato", "-gnatVa");
   end case;
   package Compiler is for Default_Switches ("Ada") use Flags; end Compiler;
   package Binder is for Switches ("Ada") use ("-Es"); end Binder;
end Stage_Probe;
