with "../../../sparkling_mujoco.gpr";
project Foundation_ABI is
   for Source_Dirs use (".", "../../../tests/gen");
   for Object_Dir use Sparkling_Mujoco.Build_Root & "/obj/foundation-abi";
   for Exec_Dir use Sparkling_Mujoco.Build_Root & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("abi_probe.adb", "reference_probe.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-O2", "-g", "-gnata", "-gnato", "-gnatVa", "-ffp-contract=off");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use Sparkling_Mujoco.Link_Switches;
   end Linker;
end Foundation_ABI;
