+       and then C.First_Edge = G.Flex_Edgeadr (F) and then C.Nedge = G.Flex_Edgenum (F)
+       and then C.First_Edge <= Z.Nflexedge and then C.Nedge <= Z.Nflexedge-C.First_Edge
+       and then C.First_Element = G.Flex_Elemadr (F) and then C.Nelem = G.Flex_Elemnum (F)
+       and then C.First_Element <= Z.Nflexelem and then C.Nelem <= Z.Nflexelem-C.First_Element
