--- a/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-loading.adb
+++ b/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-loading.adb
@@ -0,0 +1,171 @@
+with MJ.Data.Flex_Elasticity.Material_Loading;
+with Interfaces;
+with MJ.Models.Validity;
+package body MJ.Data.Flex_Elasticity.Loading with SPARK_Mode is
+   use type Interfaces.Unsigned_8;
+   procedure Copy_Edge_Columns
+     (Source : Int_Array; Target : in out Int_Array; Nv : Natural;
+      Result : out Status) with
+     Pre => (Static => Source'First = 0 and then Target'First = 0
+       and then Source'Length = Target'Length and then Nv <= Max_Dofs),
+     Post => (Static => (if Result = Success then Target = Source
+       and then (for all Column of Target => Column in 0 .. Nv-1))) is
+   begin
+      Result := Invalid_Model;
+      for I in Target'Range loop
+         if Source (I) not in 0 .. Nv-1 then return; end if;
+         Target (I) := Source (I);
+         pragma Loop_Invariant (for all K in Target'First .. I =>
+           Target (K) = Source (K) and then Target (K) in 0 .. Nv-1);
+      end loop;
+      Result := Success;
+   end Copy_Edge_Columns;
+
+   procedure Copy_Flex_Edge_Ranges
+     (Address, Count : Int_Array; Target : in out Flex_Array;
+      Nedge : Natural; Result : out Status) with
+     Pre => (Static => Address'First = 0 and then Count'First = 0
+       and then Target'First = 0 and then Address'Length = Target'Length
+       and then Count'Length = Target'Length and then Nedge <= Max_Edges),
+     Post => (Static => (if Result = Success then
+       (for all F in Target'Range => Target (F).First_Edge <= Nedge
+         and then Target (F).Nedge <= Nedge-Target (F).First_Edge
+         and then Target (F).First_Edge = Address (F)
+         and then Target (F).Nedge = Count (F)))) is
+   begin
+      Result := Invalid_Model;
+      for F in Target'Range loop
+         if Address (F) not in 0 .. Nedge
+           or else Count (F) not in 0 .. Nedge-Address (F) then return; end if;
+         Target (F).First_Edge := Address (F); Target (F).Nedge := Count (F);
+         pragma Loop_Invariant (for all K in Target'First .. F =>
+           Target (K).First_Edge <= Nedge
+           and then Target (K).Nedge <= Nedge-Target (K).First_Edge
+           and then Target (K).First_Edge = Address (K)
+           and then Target (K).Nedge = Count (K));
+      end loop;
+      Result := Success;
+   end Copy_Flex_Edge_Ranges;
+
+   procedure Copy_Edge_Rows
+     (Address, Width, Columns : Int_Array; Target : in out Edge_Array;
+      Nv, Slots : Natural; Result : out Status) with
+     Pre => (Static => Address'First = 0 and then Width'First = 0
+       and then Target'First = 0 and then Address'Length = Target'Length
+       and then Width'Length = Target'Length and then Nv <= Max_Dofs
+       and then Slots <= Max_Edge_Entries
+       and then Columns'First = 0 and then Int64 (Columns'Length) = Int64 (Slots)),
+     Post => (Static => (if Result = Success then
+       (for all I in Target'Range => Target (I).Rownnz <= Nv
+         and then Target (I).Rowadr <= Slots
+         and then Target (I).Rownnz <= Slots-Target (I).Rowadr
+         and then Target (I).Rowadr = Address (I)
+         and then Target (I).Rownnz = Width (I)
+         and then (for all P in Target (I).Rowadr+1 ..
+           Target (I).Rowadr+Target (I).Rownnz-1 =>
+             Columns (P-1) < Columns (P))))) is
+   begin
+      Result := Invalid_Model;
+      for I in Target'Range loop
+         if Address (I) not in 0 .. Slots
+           or else Width (I) not in 0 .. Nv
+           or else Width (I) > Slots-Address (I) then return; end if;
+         --  Validate ordering once at admission. Row producers consume this
+         --  immutable cache without repeating the chain scan every frame.
+         for P in Address (I)+1 .. Address (I)+Width (I)-1 loop
+            if Columns (P-1) >= Columns (P) then return; end if;
+            pragma Loop_Invariant (for all K in Address (I)+1 .. P =>
+              Columns (K-1) < Columns (K));
+         end loop;
+         Target (I).Rowadr := Address (I); Target (I).Rownnz := Width (I);
+         pragma Loop_Invariant (for all K in Target'First .. I =>
+           Target (K).Rownnz <= Nv and then Target (K).Rowadr <= Slots
+           and then Target (K).Rownnz <= Slots-Target (K).Rowadr
+           and then Target (K).Rowadr = Address (K)
+           and then Target (K).Rownnz = Width (K)
+           and then (for all P in Target (K).Rowadr+1 ..
+             Target (K).Rowadr+Target (K).Rownnz-1 =>
+               Columns (P-1) < Columns (P)));
+      end loop;
+      Result := Success;
+   end Copy_Edge_Rows;
+
+   --  Admission only: copy the compiled CSR topology once, before any frame
+   --  can consume it. The force/equality paths share this owned cache.
+   procedure Load_Edge_Layout
+     (Columns, Flex_Address, Flex_Count, Row_Address, Row_Width : Int_Array;
+      S : in out Storage; Result : out Status) with
+     Pre => (Static => Edge_Layout_Shape (S)
+       and then Columns'First = 0 and then Columns'Length = S.Edge_Columns'Length
+       and then Flex_Address'First = 0 and then Flex_Address'Length = S.Flexes'Length
+       and then Flex_Count'First = 0 and then Flex_Count'Length = S.Flexes'Length
+       and then Row_Address'First = 0 and then Row_Address'Length = S.Edges'Length
+       and then Row_Width'First = 0 and then Row_Width'Length = S.Edges'Length),
+     Post => (Static => (if Result = Success then Edge_Layout_Valid (S)
+       and then S.Edge_Columns = Columns
+       and then (for all F in S.Flexes'Range =>
+         S.Flexes (F).First_Edge = Flex_Address (F)
+         and then S.Flexes (F).Nedge = Flex_Count (F))
+       and then (for all I in S.Edges'Range =>
+         S.Edges (I).Rowadr = Row_Address (I)
+         and then S.Edges (I).Rownnz = Row_Width (I)))) is
+   begin
+      Copy_Edge_Columns (Columns, S.Edge_Columns, S.Nv, Result);
+      if Result /= Success then return; end if;
+      Copy_Flex_Edge_Ranges (Flex_Address, Flex_Count, S.Flexes, S.Nedge, Result);
+      if Result /= Success then return; end if;
+      Copy_Edge_Rows (Row_Address, Row_Width, S.Edge_Columns,
+        S.Edges, S.Nv, S.Edge_Columns'Length, Result);
+   end Load_Edge_Layout;
+
+   --  Scalar dimensions keep allocation independent of the model's pointer
+   --  graph. The caller already rejects an occupied owning handle.
+   procedure Allocate
+     (Nf, Nvert, Nedge, Nelem, Nv, Slots, Nb : Natural;
+      S : in out Storage_Access) with
+     Pre => (Static => S = null and then Nf <= Max_Flexes
+       and then Nvert <= Max_Vertices and then Nedge <= Max_Edges
+       and then Nelem <= Max_Elements and then Nv <= Max_Dofs
+       and then Slots <= Max_Edge_Entries),
+     Post => (Static => S /= null and then Edge_Layout_Shape (S.all)
+       and then S.Nf = Nf and then S.Nvert = Nvert
+       and then S.Nedge = Nedge and then S.Nelem = Nelem
+       and then S.Nv = Nv and then S.Nb = Nb
+       and then S.Vertices'Length = Nvert
+       and then S.Elements'Length = Nelem
+       and then S.Edge_Columns'Length = Slots) is
+   begin
+      S := new Storage (Nf-1, Nvert-1, Nedge-1, Nelem-1, Nv-1, Slots-1);
+      S.Nb := Nb;
+   end Allocate;
+
+   procedure Load (M : MJ.Models.Model; S : in out Storage_Access; Result : out Status) is
+      G : MJ.Models.Flex_Arrays renames M.Flexes;
+   begin
+      Result := Invalid_Model;
+      if not MJ.Models.Valid_Layout (M) then return; end if;
+      -- The rigid submodel is validated by Create before this loader runs.
+      -- The existing full validator explicitly excludes flex models.
+      if M.S.Nflex > Max_Flexes or else M.S.Nflexvert > Max_Vertices
+        or else M.S.Nflexedge > Max_Edges or else M.S.Nflexelem > Max_Elements
+        or else M.S.Nv > Max_Dofs or else M.S.NJfe > Max_Edge_Entries
+      then Result := Capacity_Exceeded; return; end if;
+      -- All constraints remain explicitly disabled by the smooth entry.
+      -- Interpolated finite elements have a different state/rotation producer.
+      for F in 0 .. M.S.Nflex - 1 loop
+         if G.Flex_Interp (F) /= 0 then Result := Unsupported_Feature; return; end if;
+         if G.Flex_Dim (F) not in 1 .. 3 then return; end if;
+         pragma Loop_Invariant (Static => (for all K in 0 .. F =>
+           G.Flex_Dim (K) in 1 .. 3));
+      end loop;
+      Allocate (M.S.Nflex, M.S.Nflexvert, M.S.Nflexedge,
+        M.S.Nflexelem, M.S.Nv, M.S.NJfe, M.S.Nbody, S);
+      Load_Edge_Layout (G.Flexedge_J_Colind.all, G.Flex_Edgeadr.all,
+        G.Flex_Edgenum.all, G.Flexedge_J_Rowadr.all, G.Flexedge_J_Rownnz.all, S.all, Result);
+      if Result /= Success then return; end if;
+      Material_Loading.Load (M.S, G, M.Bodies, M.Dofs, S.all, Result);
+   exception
+      when Constraint_Error => Result := Invalid_Model;
+   end Load;
+
+end MJ.Data.Flex_Elasticity.Loading;
--- a/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-loading.ads
+++ b/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-loading.ads
@@ -0,0 +1,8 @@
+--  Admission is isolated from the per-frame dynamics implementation so its
+--  contracts and immutable row topology can be proved independently.
+private package MJ.Data.Flex_Elasticity.Loading with SPARK_Mode is
+   procedure Load (M : MJ.Models.Model; S : in out Storage_Access; Result : out Status)
+     with Pre => (Static => S = null),
+     Post => (Static => (if Result = Success then
+       S /= null and then Edge_Layout_Valid (S.all)));
+end MJ.Data.Flex_Elasticity.Loading;
--- a/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-material_loading.adb
+++ b/experimental/flex-elasticity-integration/src/mj-data-flex_elasticity-material_loading.adb
@@ -0,0 +1,363 @@
+with Interfaces;
+package body MJ.Data.Flex_Elasticity.Material_Loading with SPARK_Mode is
+   use type Interfaces.Unsigned_8;
+   use type K.Metric;
+   procedure Load_Vertex
+     (Weld, Address, Width, Parents : Int_Array; Simple : Byte_Array;
+      Nb, Nv : Natural; Body_Id : Integer; Offset : Vector;
+      C : in out Vertex; Result : out Status) with
+     Pre => (Static => MJ.Flex_Ancestors.Body_Shape (Weld, Address, Width)
+       and then Int64 (Weld'Length) = Int64 (Nb)
+       and then Simple'First = 0 and then Int64 (Simple'Length) = Int64 (Nb)
+       and then Parents'First = 0 and then Int64 (Parents'Length) = Int64 (Nv)
+       and then Nv <= Max_Dofs),
+     Post => (Static => (if Result = Success then Body_Id in 0 .. Nb-1
+       and then C.Body_Id = Body_Id and then C.Dofnum = Width (Body_Id)
+       and then C.Dofadr = (if C.Dofnum = 0 then 0 else Address (Body_Id))
+       and then C.Simple = (Simple (Body_Id) = 2)
+       and then (if C.Simple then C.Dofnum = 3)
+       and then C.Offset = Offset and then Bounded (C.Offset, Max_Val)
+       and then MJ.Flex_Ancestors.Valid_Chain (C.Ancestors, Nv))) is
+      Chain_Result : MJ.Flex_Ancestors.Status;
+      use type MJ.Flex_Ancestors.Status;
+   begin
+      Result := Invalid_Model;
+      if Body_Id not in 0 .. Nb-1 then return; end if;
+      --  Reject malformed scalar metadata before conversion. In addition to
+      --  formerly failing conversions, validate the local body block even
+      --  when its weld root has a different, valid block.
+      if Width (Body_Id) not in 0 .. Nv then return; end if;
+      if Width (Body_Id) /= 0 and then
+        Address (Body_Id) not in 0 .. Nv-Width (Body_Id) then return; end if;
+      C.Body_Id := Body_Id; C.Dofnum := Width (Body_Id);
+      C.Dofadr := (if C.Dofnum = 0 then 0 else Address (Body_Id));
+      C.Simple := Simple (Body_Id) = 2;
+      if C.Simple and then C.Dofnum /= 3 then return; end if;
+      C.Offset := Offset;
+      if not Bounded (C.Offset, Max_Val) then return; end if;
+      MJ.Flex_Ancestors.Build (Weld, Address, Width, Parents,
+        Body_Id, 0, C.Ancestors, Chain_Result);
+      if Chain_Result /= MJ.Flex_Ancestors.Success then return; end if;
+      Result := Success;
+   end Load_Vertex;
+
+   procedure Load_Edge
+     (Weld, Address, Width, Parents : Int_Array; Vertices : Vertex_Array;
+      VA, N, Nv : Natural; V1, V2 : Integer;
+      Rest, Weight : Real; Rigid, Needs_Chain : Boolean;
+      Flap1, Flap2, Bending_Index : Integer; Bending_Data : Real_Array;
+      C : in out Edge; Result : out Status) with
+     Pre => (Static => MJ.Flex_Ancestors.Body_Shape (Weld, Address, Width)
+       and then Parents'First = 0 and then Int64 (Parents'Length) = Int64 (Nv)
+       and then Nv <= Max_Dofs and then Vertices'First = 0
+       and then Vertices'Length <= Max_Vertices
+       and then VA <= Vertices'Length and then N <= Vertices'Length-VA
+       and then Bending_Data'First = 0
+       and then Int64 (Bending_Data'Length) <= Int64 (Integer'Last)),
+     Post => (Static => C.Rowadr = C.Rowadr'Old and then C.Rownnz = C.Rownnz'Old
+       and then (if Result = Success then V1 in 0 .. N-1 and then V2 in 0 .. N-1
+         and then C.Vert (0) = VA+V1 and then C.Vert (1) = VA+V2
+         and then C.Rest = Rest and then C.Weight = Weight and then C.Rigid = Rigid
+         and then MJ.Flex_Ancestors.Valid_Chain (C.Ancestors, Nv)
+         and then (if Needs_Chain then C.Rownnz = C.Ancestors.Count)
+         and then (if Bending_Index >= 0 then
+           Bending_Index <= Bending_Data'Length-17
+           and then Flap1 in -1 .. N-1 and then Flap2 in -1 .. N-1
+           and then C.Vert (2) = (if Flap1 = -1 then -1 else VA+Flap1)
+           and then C.Vert (3) = (if Flap2 = -1 then -1 else VA+Flap2)
+           and then C.Bending = (C.Vert (3) >= 0)
+           and then (if C.Bending then C.Vert (2) >= 0)
+           and then (for all J in C.B'Range => C.B (J) = Bending_Data (Bending_Index+J))
+           else C.Vert (2) = C.Vert'Old (2) and then C.Vert (3) = C.Vert'Old (3)
+             and then C.Bending = C.Bending'Old and then C.B = C.B'Old))) is
+      Chain_Result : MJ.Flex_Ancestors.Status;
+      use type MJ.Flex_Ancestors.Status;
+   begin
+      Result := Invalid_Model;
+      if V1 not in 0 .. N-1 or else V2 not in 0 .. N-1 then return; end if;
+      if Rest not in Nonneg_Tier0 or else Weight not in Nonneg_Tier0 then return; end if;
+      C.Vert (0) := VA+V1; C.Vert (1) := VA+V2;
+      C.Rest := Rest; C.Rigid := Rigid; C.Weight := Weight;
+      if Vertices (VA+V1).Body_Id >= Weld'Length
+        or else Vertices (VA+V2).Body_Id >= Weld'Length then return; end if;
+      MJ.Flex_Ancestors.Build (Weld, Address, Width, Parents,
+        Vertices (VA+V1).Body_Id, Vertices (VA+V2).Body_Id,
+        C.Ancestors, Chain_Result);
+      if Chain_Result /= MJ.Flex_Ancestors.Success then return; end if;
+      if Needs_Chain and then C.Rownnz /= C.Ancestors.Count then return; end if;
+      if Bending_Index >= 0 then
+         if Bending_Index > Bending_Data'Length-17
+           or else Flap1 not in -1 .. N-1 or else Flap2 not in -1 .. N-1 then return; end if;
+         C.Vert (2) := (if Flap1 = -1 then -1 else VA+Flap1);
+         C.Vert (3) := (if Flap2 = -1 then -1 else VA+Flap2);
+         C.Bending := C.Vert (3) >= 0;
+         if C.Bending and then C.Vert (2) < 0 then return; end if;
+         for J in C.B'Range loop
+            if Bending_Data (Bending_Index+J) not in K.Coefficient then return; end if;
+            C.B (J) := Bending_Data (Bending_Index+J);
+            pragma Loop_Invariant (Static => (for all K2 in C.B'First .. J =>
+              C.B (K2) = Bending_Data (Bending_Index+K2)));
+         end loop;
+      end if;
+      Result := Success;
+   end Load_Edge;
+
+   --  Row starts in C's ordered upper-triangular packing. Ghost only;
+   --  runtime retains the original sequential counter and stride21.
+   function Packed_Row_First (Width, Row : Integer) return Integer is
+     (case Row is when 0 => 0, when 1 => Width, when 2 => 2*Width-1,
+       when 3 => 3*Width-3, when 4 => 4*Width-6,
+       when 5 => 5*Width-10, when others => 21)
+     with Ghost => Static, Global => null,
+       Pre => Width in 3 | 6 and then Row in 0 .. Width;
+
+   procedure Load_Metric
+     (Values : Real_Array; Address, Width : Natural;
+      M : in out K.Metric; Result : out Status) with
+     Pre => (Static => Values'First = 0
+       and then Int64 (Values'Length) <= Int64 (Integer'Last)
+       and then Width in 3 | 6 and then Address <= Values'Length-21),
+     Post => (Static => (if Result = Success then
+       (for all R in 0 .. Width-1 => (for all C2 in R .. Width-1 =>
+         M (R, C2) = Values (Address+(Packed_Row_First (Width, R)+C2-R))
+         and then M (C2, R) = Values (Address+(Packed_Row_First (Width, R)+C2-R))))
+       and then (for all A in 0 .. 5 => (for all B in 0 .. 5 =>
+         (if A >= Width or else B >= Width then M (A, B) = M'Old (A, B)))))) is
+      P : Natural := 0;
+      Initial : constant K.Metric := M with Ghost => Static;
+   begin
+      Result := Invalid_Model;
+      for R in 0 .. Width-1 loop
+         pragma Loop_Invariant (Static => P = Packed_Row_First (Width, R));
+         pragma Loop_Invariant (Static => P in 0 .. 20);
+         pragma Loop_Invariant (Static => (for all A in 0 .. R-1 =>
+           (for all B in A .. Width-1 =>
+             M (A, B) = Values (Address+(Packed_Row_First (Width, A)+B-A))
+             and then M (B, A) = Values (Address+(Packed_Row_First (Width, A)+B-A)))));
+         pragma Loop_Invariant (Static => (for all A in R .. 5 =>
+           (for all B in R .. 5 => M (A, B) = Initial (A, B))));
+         pragma Loop_Invariant (Static => (for all A in 0 .. 5 =>
+           (for all B in 0 .. 5 => (if A >= Width or else B >= Width then M (A, B) = Initial (A, B)))));
+         for C2 in R .. Width-1 loop
+            if Values (Address+P) not in K.Coefficient then return; end if;
+            M (R, C2) := Values (Address+P);
+            M (C2, R) := M (R, C2);
+            P := P+1;
+            pragma Loop_Invariant (Static => P = Packed_Row_First (Width, R) + C2-R+1);
+            pragma Loop_Invariant (Static => P in 1 .. 21);
+            pragma Loop_Invariant (Static => (for all A in 0 .. R-1 =>
+              (for all B in A .. Width-1 =>
+                M (A, B) = Values (Address+(Packed_Row_First (Width, A)+B-A))
+                and then M (B, A) = Values (Address+(Packed_Row_First (Width, A)+B-A)))));
+            pragma Loop_Invariant (Static => (for all B in R .. C2 =>
+              M (R, B) = Values (Address+(Packed_Row_First (Width, R)+B-R))
+              and then M (B, R) = Values (Address+(Packed_Row_First (Width, R)+B-R))));
+            pragma Loop_Invariant (Static => (for all A in R+1 .. 5 =>
+              (for all B in R+1 .. 5 => M (A, B) = Initial (A, B))));
+            pragma Loop_Invariant (Static => (for all B in C2+1 .. Width-1 =>
+              M (R, B) = Initial (R, B) and then M (B, R) = Initial (B, R)));
+            pragma Loop_Invariant (Static => (for all A in 0 .. 5 =>
+              (for all B in 0 .. 5 => (if A >= Width or else B >= Width then M (A, B) = Initial (A, B)))));
+         end loop;
+         pragma Assert (Static => P = Packed_Row_First (Width, R+1));
+      end loop;
+      Result := Success;
+   end Load_Metric;
+
+   procedure Load_Element
+     (Vertex_Data, Edge_Data : Int_Array; Stiffness : Real_Array;
+      Vertex_Dataadr, Edge_Dataadr, VA, N, EA, Nedge, Dim : Natural;
+      Stiffness_Index : Integer; C : in out Element; Result : out Status) with
+     Pre => (Static => Dim in 2 .. 3
+       and then Vertex_Data'First = 0 and then Edge_Data'First = 0
+       and then Stiffness'First = 0
+       and then Int64 (Vertex_Data'Length) <= Int64 (Integer'Last)
+       and then Int64 (Edge_Data'Length) <= Int64 (Integer'Last)
+       and then Int64 (Stiffness'Length) <= Int64 (Integer'Last)
+       and then Vertex_Dataadr <= Vertex_Data'Length-(Dim+1)
+       and then Edge_Dataadr <= Edge_Data'Length-(if Dim = 2 then 3 else 6)
+       and then VA <= Max_Vertices and then N <= Max_Vertices-VA
+       and then EA <= Max_Edges and then Nedge <= Max_Edges-EA
+       and then Stiffness_Index >= -1
+       and then (if Stiffness_Index >= 0 then Stiffness_Index <= Stiffness'Length-21)),
+     Post => (Static => (if Result = Success then
+       (for all J in C.Vert'Range =>
+          (if J <= Dim then C.Vert (J) = VA+Vertex_Data (Vertex_Dataadr+J)
+           and then C.Vert (J) in VA .. VA+N-1 else C.Vert (J) = C.Vert'Old (J)))
+       and then (for all J in C.Edges'Range =>
+          (if J < (if Dim = 2 then 3 else 6) then
+            C.Edges (J) = EA+Edge_Data (Edge_Dataadr+J)
+            and then C.Edges (J) in EA .. EA+Nedge-1 else C.Edges (J) = C.Edges'Old (J)))
+       and then (if Stiffness_Index >= 0 then
+         (for all R in 0 .. (if Dim = 2 then 2 else 5) =>
+           (for all C2 in R .. (if Dim = 2 then 2 else 5) =>
+             C.M (R, C2) = Stiffness (Stiffness_Index+
+               (Packed_Row_First ((if Dim = 2 then 3 else 6), R)+C2-R))
+             and then C.M (C2, R) = C.M (R, C2)))
+         and then (for all A in 0 .. 5 => (for all B in 0 .. 5 =>
+           (if A >= (if Dim = 2 then 3 else 6) or else B >= (if Dim = 2 then 3 else 6)
