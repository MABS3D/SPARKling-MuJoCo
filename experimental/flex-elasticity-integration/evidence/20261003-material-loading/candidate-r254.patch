+--  Only the compiled arrays consumed by FLEX admission cross this boundary.
+--  CSR topology has already been checked and copied by Loading.
+private package MJ.Data.Flex_Elasticity.Material_Loading with SPARK_Mode is
+   pragma Unevaluated_Use_Of_Old (Allow);
+   procedure Load
+     (Z : MJ.Models.Sizes; G : MJ.Models.Flex_Arrays;
+      Bodies : MJ.Models.Body_Arrays; Dofs : MJ.Models.Dof_Arrays;
+      S : in out Storage; Result : out Status)
+     with Pre => (Static => MJ.Models.Sizes_In_Range (Z)
+       and then MJ.Models.Flex_Layout_OK (Z, G)
+       and then MJ.Models.Body_Layout_OK (Z, Bodies)
+       and then MJ.Models.Dof_Layout_OK (Z, Dofs)
+       and then Edge_Layout_Valid (S)
+       and then S.Nf = Z.Nflex and then S.Nvert = Z.Nflexvert
+       and then S.Nedge = Z.Nflexedge and then S.Nelem = Z.Nflexelem
+       and then S.Nv = Z.Nv and then S.Nb = Z.Nbody
+       and then Int64 (S.Vertices'Length) = Int64 (Z.Nflexvert)
+       and then Int64 (S.Elements'Length) = Int64 (Z.Nflexelem)
+       and then Z.Nflexvert <= Max_Vertices and then Z.Nflexelem <= Max_Elements
+       and then (for all F in S.Flexes'Range =>
+         S.Flexes (F).First_Edge = G.Flex_Edgeadr (F)
+         and then S.Flexes (F).Nedge = G.Flex_Edgenum (F))
+       and then (for all F in S.Flexes'Range => G.Flex_Dim (F) in 1 .. 3)),
+     Post => (Static => (if Result = Success then Edge_Layout_Valid (S)
+       and then S.Nf = S.Nf'Old and then S.Nedge = S.Nedge'Old
+       and then S.Nv = S.Nv'Old
+       and then S.Edge_Columns = S.Edge_Columns'Old
+       and then (for all F in S.Flexes'Range =>
+         S.Flexes (F).First_Edge = S.Flexes'Old (F).First_Edge
+         and then S.Flexes (F).Nedge = S.Flexes'Old (F).Nedge)
+       and then (for all I in S.Edges'Range =>
+         S.Edges (I).Rowadr = S.Edges'Old (I).Rowadr
+         and then S.Edges (I).Rownnz = S.Edges'Old (I).Rownnz)));
+end MJ.Data.Flex_Elasticity.Material_Loading;
