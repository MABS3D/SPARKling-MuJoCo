project NoSlip extends "../constrained-step/constrained.gpr" is
   NoSlip_Root := external ("NOSLIP_BUILD_ROOT", "/var/tmp/sparkling-noslip");
   NoSlip_Mode := external ("NOSLIP_MODE", "validation");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use NoSlip_Root & "/" & NoSlip_Mode & "/obj";
   for Exec_Dir use NoSlip_Root & "/" & NoSlip_Mode & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("noslip_probe.adb", "noslip_step_probe.adb");
   NoSlip_Flags := ("-gnat2022", "-ffp-contract=off");
   case NoSlip_Mode is
      when "release" => NoSlip_Flags := NoSlip_Flags & ("-O3", "-gnatn", "-march=native");
      when others => NoSlip_Flags := NoSlip_Flags & ("-O1", "-g", "-gnata", "-gnato", "-gnatVa");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use NoSlip_Flags;
   end Compiler;
end NoSlip;
