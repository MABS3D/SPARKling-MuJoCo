diff --git a/src/engine/engine_collision_driver.c b/src/engine/engine_collision_driver.c
index 9617b6f..093e56e 100644
--- a/src/engine/engine_collision_driver.c
+++ b/src/engine/engine_collision_driver.c
@@ -71,6 +71,10 @@ int mj_maxContact(const mjModel* m, int g1, int g2, int has_margin) {
   int type2 = m->geom_type[g2];
 
   if (type1 == mjGEOM_SDF || type2 == mjGEOM_SDF) {
+    // mesh-SDF samples each face and can generate more contacts than sdf_initpoints
+    if (type1 == mjGEOM_MESH || type2 == mjGEOM_MESH) {
+      return mjMAXCONPAIR;
+    }
     return m->opt.sdf_initpoints;
   }
 
diff --git a/test/engine/engine_collision_driver_test.cc b/test/engine/engine_collision_driver_test.cc
index aaf9f39..0ea607e 100644
--- a/test/engine/engine_collision_driver_test.cc
+++ b/test/engine/engine_collision_driver_test.cc
@@ -521,5 +521,59 @@ TEST_F(MjCollisionTest, Flex3DActiveLayersMidphaseDisabled) {
   }
 }
 
+// A single starting point per mesh face can still generate multiple contacts.
+TEST_F(MjCollisionTest, MeshSdfContactCapacity) {
+  static constexpr char kMeshSdfXml[] = R"(
+  <mujoco>
+    <option sdf_initpoints="1"/>
+    <asset>
+      <mesh name="cube" vertex="-.2 -.2 -.2  .2 -.2 -.2  .2 .2 -.2  -.2 .2 -.2
+                               -.2 -.2 .2  .2 -.2 .2  .2 .2 .2  -.2 .2 .2"/>
+      <mesh name="tetra" vertex="-.07 -.07 -.07  .07 .07 -.07
+                                 .07 -.07 .07  -.07 .07 .07"/>
+    </asset>
+    <worldbody>
+      <geom type="sdf" mesh="cube"/>
+      <body pos=".24 .019 .013">
+        <freejoint/>
+        <geom type="mesh" mesh="tetra"/>
+      </body>
+    </worldbody>
+  </mujoco>
+  )";
+  char error[1024];
+  MjModelPtr model = LoadModelFromString(kMeshSdfXml, error, sizeof(error));
+  ASSERT_THAT(model.get(), NotNull()) << error;
+
+  for (int nthread : {0, 2}) {
+    SCOPED_TRACE(nthread);
+    MjDataPtr data = MakeData(model);
+    ASSERT_THAT(data, NotNull());
+    if (nthread) {
+      mju_threadpool(data.get(), nthread);
+    }
+    for (int initpoints : {1, 4, 40, 80}) {
+      SCOPED_TRACE(initpoints);
+      model->opt.sdf_initpoints = initpoints;
+      mj_kinematics(model.get(), data.get());
+
+      // Use a full buffer to check the capacity before exercising the driver.
+      mjPreContact con[mjMAXCONPAIR];
+      int ncon = mjCOLLISIONFUNC[mjGEOM_MESH][mjGEOM_SDF](
+          model.get(), data.get(), con, 1, 0, 0);
+      ASSERT_GT(ncon, 0);
+      if (initpoints == 1) {
+        EXPECT_GT(ncon, initpoints);
+      }
+      ASSERT_LE(ncon, mj_maxContact(model.get(), 0, 1, -1));
+      ASSERT_LE(ncon, mj_maxContact(model.get(), 1, 0, -1));
+      EXPECT_EQ(mj_maxContact(model.get(), 0, 1, -1), mjMAXCONPAIR);
+
+      mj_forward(model.get(), data.get());
+      EXPECT_EQ(data->ncon, ncon);
+    }
+  }
+}
+
 }  // namespace
 }  // namespace mujoco
