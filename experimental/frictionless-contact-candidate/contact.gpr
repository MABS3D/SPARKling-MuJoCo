project Contact is
   Build_Root := external ("CONTACT_BUILD_ROOT", "/var/tmp/sparkling-contact-20260929/build");
   type Mode_Type is ("development", "validation", "release");
   Mode : Mode_Type := external ("CONTACT_MODE", "validation");
   for Source_Dirs use ("src", "../../src", "../collision/src", "tests");
   for Source_Files use ("mj.ads", "mj-types.ads", "mj-collision.ads", "mj-collision.adb",
     "mj-contact_rows.ads", "mj-contact_rows.adb", "mj-contact_slider.ads", "mj-contact_slider.adb",
     "contact_probe.adb");
   for Main use ("contact_probe.adb");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "development" => Flags := Flags & ("-O0", "-g", "-gnata", "-gnato", "-gnatVa");
      when "validation" => Flags := Flags & ("-O2", "-g", "-gnata", "-gnato", "-gnatVa");
      when "release" => Flags := Flags & ("-O3", "-gnatp", "-gnatn", "-march=native", "-flto");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-flto", "-ffp-contract=off");
   end Linker;
end Contact;
