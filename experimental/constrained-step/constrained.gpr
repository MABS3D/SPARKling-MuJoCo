project Constrained is
   Build_Root := external ("CONSTRAINED_BUILD_ROOT", "/var/tmp/sparkling-constrained-step");
   Mode := external ("CONSTRAINED_MODE", "validation");
   for Source_Dirs use ("src", "tests", "../../src", "../../src/gen",
     "../smooth/src", "../spatial-tendon-candidate/src", "../muscle-candidate/src",
     "../rigid-collision-candidate/src", "../constraint-assembly-candidate/src",
     "../constraint-solvers-candidate/src", "../joint-limit-candidate/src",
     "../frictionless-contact-candidate/src");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Main use ("constrained_probe.adb", "constrained_edges.adb", "constrained_activation_edges.adb", "equality_lifecycle.adb");
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "release" => Flags := Flags & ("-O3", "-gnatn2", "-march=native", "-flto");
      when others => Flags := Flags & ("-O1", "-g", "-gnata", "-gnato", "-gnatVa");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Linker is
      case Mode is
         when "release" => for Default_Switches ("Ada") use ("-lm", "-flto");
         when others => for Default_Switches ("Ada") use ("-lm");
      end case;
   end Linker;
end Constrained;
