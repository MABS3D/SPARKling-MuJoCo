project Derivatives is
   Build_Root := external ("DERIVATIVES_BUILD_ROOT", "/var/tmp/sparkling-derivatives");
   Mode := external ("DERIVATIVES_MODE", "validation");
   for Source_Dirs use ("src", "tests", "../../src", "../../src/gen",
     "../smooth/src", "../spatial-tendon-candidate/src", "../muscle-candidate/src",
     "../constrained-step/src", "../inverse-dynamics/src", "../inverse-dynamics/tests", "../rigid-collision-candidate/src",
     "../constraint-assembly-candidate/src", "../constraint-solvers-candidate/src",
     "../joint-limit-candidate/src", "../frictionless-contact-candidate/src");
   for Object_Dir use Build_Root & "/" & Mode & "/obj";
   for Exec_Dir use Build_Root & "/" & Mode & "/bin";
   for Main use ("derivatives_probe.adb", "inverse_probe.adb", "inverse_rows_probe.adb", "native_mass_probe.adb");
   for Create_Missing_Dirs use "True";
   Flags := ("-gnat2022", "-ffp-contract=off");
   case Mode is
      when "release" => Flags := Flags & ("-O3", "-gnatn", "-march=native", "-flto=1");
      when others => Flags := Flags & ("-O1", "-g", "-gnata", "-gnato", "-gnatVa");
   end case;
   package Compiler is
      for Default_Switches ("Ada") use Flags;
      case Mode is
         when "release" => for Switches ("mj-solver_kernels.adb") use
           Flags & ("-mprefer-vector-width=256");
         when others => null;
      end case;
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
   package Linker is
      case Mode is
         when "release" => for Default_Switches ("Ada") use
           ("-lm", "-O3", "-march=native", "-ffp-contract=off", "-flto=1");
         when others => for Default_Switches ("Ada") use ("-lm");
      end case;
   end Linker;
end Derivatives;
