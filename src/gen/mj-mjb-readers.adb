      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 75); return; end if;
      Vis.Rgba.Bv (0) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bv + 4);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 75); return; end if;
      Vis.Rgba.Bv (1) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bv + 8);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 75); return; end if;
      Vis.Rgba.Bv (2) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bv + 12);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 75); return; end if;
      Vis.Rgba.Bv (3) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bvactive + 0);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 76); return; end if;
      Vis.Rgba.Bvactive (0) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bvactive + 4);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 76); return; end if;
      Vis.Rgba.Bvactive (1) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bvactive + 8);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 76); return; end if;
      Vis.Rgba.Bvactive (2) := Bits_To_Float (U32);
      U32 := Get_U32 (B, Base + Visual_Off_Rgba_Bvactive + 12);
      if not Is_Finite_F32 (U32) then Result := (Non_Finite_Value, Visual_Block, 76); return; end if;
      Vis.Rgba.Bvactive (3) := Bits_To_Float (U32);
      Base := Base + Visual_Size;
      --  Statistic_Block
      U64 := Get_U64 (B, Base + Statistic_Off_Meaninertia);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 0); return; end if;
      Stat.Meaninertia := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Meanmass);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 1); return; end if;
      Stat.Meanmass := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Meansize);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 2); return; end if;
      Stat.Meansize := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Extent);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 3); return; end if;
      Stat.Extent := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Center + 0);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 4); return; end if;
      Stat.Center (0) := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Center + 8);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 4); return; end if;
      Stat.Center (1) := Bits_To_Real (U64);
      U64 := Get_U64 (B, Base + Statistic_Off_Center + 16);
      if not Is_Finite_F64 (U64) then Result := (Non_Finite_Value, Statistic_Block, 4); return; end if;
      Stat.Center (2) := Bits_To_Real (U64);
      Base := Base + Statistic_Size;
      Gravcomp := Get_U8 (B, Base) /= 0;
      Surfacevel := Get_U8 (B, Base + Bool_Size) /= 0;
      Pos := Base + 2 * Bool_Size;
   end Read_Fixed;

