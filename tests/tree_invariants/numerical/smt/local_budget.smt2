(set-logic QF_NRA)
(set-option :timeout 10000)
(define-fun u () Real (/ 1 9007199254740992))
(declare-const q Real)
(declare-const b Real)
(declare-const p Real)
(declare-const h_error Real)
(declare-const n_error Real)
(assert (and (>= q (- 1 (* 144 u))) (>= b (/ 1 2)) (= p (* q b))))
(push)
(assert (< p (/ 49 100)))
(check-sat)
(pop)
; h_error bounds the direction change of the rounded Hamilton product.
; n_error bounds projection of the normalized binary64 result back to the sphere.
(assert (and (>= h_error 0) (<= (* p h_error) (* 64 u))))
(assert (and (>= n_error 0) (<= n_error (* 128 u))))
(assert (> (+ h_error n_error) (* 512 u)))
(check-sat)
