(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const n Real)
(declare-const N Real)
(declare-const S Real)
(declare-const a Real)
(declare-const A Real)
(assert (and (<= 1 n) (<= n 2) (<= 1 S) (<= S 4) (>= N 0) (= (* N N) S)))
(push)
(assert (or (= n 0) (= N 0) (= (* n N) 0)))
(check-sat)
(pop)
(push)
(assert (not (= (- (/ a n) (/ A N))
                (+ (/ (- a A) n) (/ (* A (- N n)) (* n N))))))
(check-sat)
(pop)
