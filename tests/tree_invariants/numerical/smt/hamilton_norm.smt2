(set-logic QF_NRA)
(set-option :timeout 10000)
(declare-const a0 Real)
(declare-const a1 Real)
(declare-const a2 Real)
(declare-const a3 Real)
(declare-const b0 Real)
(declare-const b1 Real)
(declare-const b2 Real)
(declare-const b3 Real)
(define-fun p0 () Real (+ (* 1 a0 b0) (* -1 a1 b1) (* -1 a2 b2) (* -1 a3 b3)))
(define-fun p1 () Real (+ (* 1 a0 b1) (* 1 a1 b0) (* 1 a2 b3) (* -1 a3 b2)))
(define-fun p2 () Real (+ (* 1 a0 b2) (* -1 a1 b3) (* 1 a2 b0) (* 1 a3 b1)))
(define-fun p3 () Real (+ (* 1 a0 b3) (* 1 a1 b2) (* -1 a2 b1) (* 1 a3 b0)))
(assert (not (= (+ (* p0 p0) (* p1 p1) (* p2 p2) (* p3 p3)) (* (+ (* a0 a0) (* a1 a1) (* a2 a2) (* a3 a3)) (+ (* b0 b0) (* b1 b1) (* b2 b2) (* b3 b3))))))
(check-sat)
