with "../sparkling_mujoco.gpr";

project Tests is
   for Source_Dirs use (".", "support", "gen");
   for Object_Dir use Sparkling_Mujoco.Build_Root & "/obj/tests";
   for Exec_Dir use Sparkling_Mujoco.Build_Root & "/bin";
   for Create_Missing_Dirs use "True";
   for Main use ("test_types.adb", "test_model_alloc.adb", "test_bytes.adb", "test_parse_raw.adb",
                 "test_corpus_raw.adb", "test_validate.adb", "test_validity.adb", "test_corpus.adb");

   package Compiler is
      --  no -gnatwa: tests assert static facts on purpose and the "always True" notes are noise
      for Default_Switches ("Ada") use ("-gnat2022", "-g", "-gnata", "-gnato");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use Sparkling_Mujoco.Link_Switches;
   end Linker;
end Tests;
